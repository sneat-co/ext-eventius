{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "release": {
    "projects": ["ext-eventius-contract"],
    "projectsRelationship": "fixed",
    "releaseTagPattern": "v{version}",
    "git": { "commit": true, "tag": true, "push": true },
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk",
      "preVersionCommand": "pnpm exec nx build ext-eventius-contract --skip-nx-cache",
      "manifestRootsToUpdate": [
        "{projectRoot}",
        "dist/{projectRoot}"
      ]
    },
    "changelog": { "workspaceChangelog": true, "automaticFromRef": true },
    "publish": {
      "executor": "@nx/js:release-publish",
      "options": { "packageRoot": "dist/{projectRoot}", "access": "public" }
    }
  }
}
